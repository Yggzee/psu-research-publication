  "cards": [
    {
      "dot": "cyan",
      "title": "Dual Persistence Sync",
      "items": [
        "All 6 core tables exist identically in local SQLite (WAL mode) and Turso Cloud SQLite.",
        "Foreign keys enforce ON DELETE CASCADE on user_id and publication_id."
      ]
    },
    {
      "dot": "amber",
      "title": "Author-Exclusive Attribution",
      "items": [
        "publications.owner_id links logically to researchers rather than rigid DB locks.",
        "reattributePublicationsByAuthorName() reconciles ownership from verified author lists."
      ]
    }
  ]
